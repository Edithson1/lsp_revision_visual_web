# Publicación por lista permitida: todo archivo nuevo queda fuera por defecto.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/server.py
!/iniciar.ps1
!/INICIAR_REVISION_VISUAL.bat
!/dist/
/dist/*
!/dist/*.html
!/dist/*.css
!/dist/*.js
!/tests/
/tests/*
!/tests/test_app.py
!/tests/test_portable.py
!/tests/test_playback.cjs
!/data/
/data/*
!/data/README.md

# Datos, multimedia, capturas, paquetes y secretos, también en subcarpetas.
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.env
.env.*
*.pem
*.key
*.log
*.tmp
*.bak
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.png
*.jpg
*.jpeg
*.gif
*.csv
*.xlsx
*.xls
*.json
*.jsonl
*.zip
*.7z
*.rar
*.exe
*.dll
*.task
*.onnx
*.pt
*.npz
*.npy
~$*
